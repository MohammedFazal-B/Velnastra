# Copy to .env. Public assets normally need no token.
# If a dataset requires authorization, use your own read-only Hugging Face token.
HF_TOKEN=
FORCE_REBUILD=false
COMPOSE_BAKE=false

# Serving is offline after scripts.prepare_assets has populated local assets.
DATASET_UPDATE_TIMEZONE=Asia/Kolkata
ENABLE_DATASET_UPDATES=false
MAX_PENDING_EVALUATIONS=3
LLM_GPU_LAYERS=-1
LLM_CONTEXT_SIZE=8192
